# Staging Environment
APP_ENV=staging
DEBUG=False
AUTH_DISABLED=False

# Database
DATABASE_URL=postgresql://otto_user:otto_password@staging-db:5432/otto_db

# Redis
REDIS_URL=redis://staging-redis:6379/0

# External APIs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI Features
AI_ENABLED=True

# Payment (use test keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://staging.otto.app/billing?success=true
STRIPE_CANCEL_URL=https://staging.otto.app/billing?cancelled=true

# Monitoring
SENTRY_DSN=https://xxx@sentry.io/xxx

# Security
SECRET_KEY=