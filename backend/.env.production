# Production Environment
APP_ENV=production
DEBUG=False
AUTH_DISABLED=False
BASE_APP_URL=https://otto-cloud.okeldijital.com

# Database
DATABASE_URL=postgresql://otto_user:otto_password@prod-db:5432/otto_db

# Redis
REDIS_URL=redis://prod-redis:6379/0

# External APIs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI Features
AI_ENABLED=True

# Payment (use live keys)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://otto-cloud.okeldijital.com/#/billing?success=true
STRIPE_CANCEL_URL=https://otto-cloud.okeldijital.com/#/billing?cancelled=true

# Monitoring
SENTRY_DSN=https://xxx@sentry.io/xxx

# Security (REQUIRED - generate unique secret)
SECRET_KEY=

# Backups
BACKUP_RETENTION_COUNT=7

# CORS (replace with your frontend URL)
CORS_ORIGINS=https://otto-cloud.okeldijital.com