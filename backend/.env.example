# Backend Environment Variables
DEBUG=True
DATABASE_URL=sqlite:///./otto.db
# For PostgreSQL: DATABASE_URL=postgresql://otto_user:otto_password@db:5432/otto_db

SECRET_KEY=change-this-secret-key-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# CORS (add your frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# External APIs (Optional - for metadata enrichment)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
MUSICBRAINZ_USER_AGENT=OTTO/1.0.0
