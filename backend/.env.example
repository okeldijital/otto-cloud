# OTTO Backend Environment Variables
APP_ENV=development  # 'development', 'staging', 'production', or 'cloud'
APP_NAME=OTTO

# --- DATABASE CONFIG ---
# Local SQLite Mode (default)
# DATABASE_URL=sqlite:////tmp/otto/data/db/otto.sqlite

# Neon / PostgreSQL Mode
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- SECURITY ---
SECRET_KEY=otto-internal-secret-key-development

# --- STORAGE ROOTS (Optional Overrides) ---
# Defaults are relative to OTTO_APP_DATA_DIR (or /tmp/otto/data in cloud)
# STORAGE_ROOT=/tmp/otto/data/storage
# BACKUP_ROOT=/tmp/otto/backups
# TEMP_ROOT=/tmp/otto/data/temp
# EVIDENCE_ROOT=/tmp/otto/data/evidence

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,https://otto-frontend.vercel.app
