FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates wget poppler-utils tesseract-ocr tesseract-ocr-eng \
  && wget -q https://raw.githubusercontent.com/tesseract-ocr/tessdata/main/zul.traineddata -O /usr/share/tesseract-ocr/5/tessdata/zul.traineddata \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json ./package.json
RUN npm install --omit=dev
COPY server.mjs ./server.mjs

ENV PORT=80
EXPOSE 80

CMD ["node", "server.mjs"]
