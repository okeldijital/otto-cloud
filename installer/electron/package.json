{
  "name": "otto-installer-electron",
  "version": "1.0.1",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --publish never",
    "build:mac": "electron-builder --publish never && bash scripts/smoke_packaged_macos.sh"
  },
  "devDependencies": {
    "electron": "27.0.0",
    "electron-builder": "24.6.4"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "tree-kill": "^1.2.2"
  },
  "build": {
    "afterPack": "afterPack.js",
    "appId": "com.otto.desktop",
    "productName": "OTTO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/",
        "to": "backend/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend/dist/",
        "to": "frontend/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
