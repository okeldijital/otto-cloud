{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "nextjs",
      "routePrefix": "/",
      "buildCommand": "npm run build",
      "installCommand": "npm install --legacy-peer-deps",
      "outputDirectory": ".next",
      "bindings": [
        {
          "type": "service",
          "service": "ocr",
          "format": "url",
          "env": "OCR_WORKER_URL"
        }
      ]
    },
    "ocr": {
      "root": "ocr-worker/",
      "runtime": "container",
      "routePrefix": "/ocr-worker",
      "entrypoint": "Dockerfile.vercel"
    }
  }
}
