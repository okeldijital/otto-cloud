  workspace workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id], map: "ix_workspace_readiness_scores_workspace_id")
  @@index([organization_id], map: "ix_workspace_readiness_scores_organization_id")
  @@map("workspace_readiness_scores")
}

model workspace_template_fields {
