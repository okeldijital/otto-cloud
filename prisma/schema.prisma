  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
  contact_person String?   @db.VarChar(255)
  artists        artists[]
  works          works[]

  @@index([id], map: "ix_publishers_id")
  @@index([name], map: "ix_publishers_name")
}

model releases {
  id                            Int                             @id @default(autoincrement())
  release_id                    String?                         @unique(map: "ix_releases_release_id") @db.VarChar(50)
  title                         String                          @db.VarChar(255)
  upc_code                      String?                         @unique @db.VarChar(50)
  release_date                  DateTime?                       @db.Date
  release_type                  String?                         @db.VarChar(50)
  cover_art_url                 String?                         @db.VarChar(500)
  streaming_link                String?                         @db.VarChar(500)
  label_id                      Int?
  artist_id                     Int?
  distributor_id                Int?
  created_at                    DateTime?                       @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime?                       @db.Timestamptz(6)
  catalog_number                String?                         @unique(map: "ix_releases_catalog_number") @db.VarChar(50)
  artist_ids                    Json?                           @db.Json
  credits                       Json?                           @db.Json
  organization_id               String                          @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  is_deleted                    Boolean                         @default(false)
  contract_intake_release_links contract_intake_release_links[]
  organizations                 organizations?                  @relation(fields: [distributor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_releases_distributor_id_organizations")
  artists                       artists?                        @relation(fields: [artist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labels                        labels?                         @relation(fields: [label_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  track_releases                track_releases[]
  tracks                        tracks[]

  @@index([id], map: "ix_releases_id")
  @@index([organization_id], map: "ix_releases_organization_id")
  @@index([title], map: "ix_releases_title")
}

model report_artifacts {
  id              Int         @id @default(autoincrement())
  organization_id String      @db.Uuid
  report_run_id   Int
  format          String      @db.VarChar(10)
  storage_path    String      @db.VarChar(500)
  filename        String      @db.VarChar(255)
  mime_type       String      @db.VarChar(100)
  file_size_bytes Int
  created_at      DateTime?   @default(now()) @db.Timestamptz(6)
  report_runs     report_runs @relation(fields: [report_run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organization_id], map: "ix_report_artifacts_organization_id")
  @@index([report_run_id], map: "ix_report_artifacts_report_run_id")
}

model report_definitions {
  id                 Int           @id @default(autoincrement())
  organization_id    String        @db.Uuid
  name               String        @db.VarChar(255)
  description        String?
  report_type        String        @db.VarChar(100)
  config_json        String
  created_by_user_id Int
  created_at         DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?     @db.Timestamptz(6)
  users              User          @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  report_runs        report_runs[]

  @@unique([organization_id, name], map: "uq_report_definitions_org_name")
  @@index([organization_id], map: "ix_report_definitions_organization_id")
  @@index([report_type], map: "ix_report_definitions_report_type")
}

model report_runs {
  id                   Int                 @id @default(autoincrement())
  organization_id      String              @db.Uuid
  report_definition_id Int?
  status               String              @db.VarChar(50)
  requested_by_user_id Int
  parameters_json      String
  row_count            Int?
  error                String?
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?           @db.Timestamptz(6)
  report_artifacts     report_artifacts[]
  report_definitions   report_definitions? @relation(fields: [report_definition_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                User                @relation(fields: [requested_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organization_id], map: "ix_report_runs_organization_id")
  @@index([report_definition_id], map: "ix_report_runs_report_definition_id")
  @@index([status], map: "ix_report_runs_status")
}

model royalties {
  id             Int       @id @default(autoincrement())
  royalty_id     String?   @unique(map: "ix_royalties_royalty_id") @db.VarChar(50)
  artist_id      Int?
  work_id        Int?
  track_id       Int?
  source         String?   @db.VarChar(100)
  amount         Decimal?  @db.Decimal(15, 2)
  currency       String?   @db.VarChar(3)
  statement_date DateTime? @db.Date
  fees           Decimal?  @db.Decimal(15, 2)
  advances       Decimal?  @db.Decimal(15, 2)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
  artists        artists?  @relation(fields: [artist_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tracks         tracks?   @relation(fields: [track_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  works          works?    @relation(fields: [work_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_royalties_id")
  @@index([source], map: "ix_royalties_source")
  @@index([statement_date], map: "ix_royalties_statement_date")
}

model status_quo_items {
  id                  Int       @id @default(autoincrement())
  organization_id     String    @db.Uuid
  entity_type         String    @db.VarChar(50)
  entity_id           Int
  issue_type          String    @db.VarChar(100)
  severity            String    @db.VarChar(20)
  summary             String    @db.VarChar(255)
  details_json        String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  resolved_at         DateTime? @db.Timestamptz(6)
  resolved_by_user_id Int?
  users               User?     @relation(fields: [resolved_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity_id], map: "ix_status_quo_items_entity_id")
  @@index([entity_type], map: "ix_status_quo_items_entity_type")
  @@index([id], map: "ix_status_quo_items_id")
  @@index([issue_type], map: "ix_status_quo_items_issue_type")
  @@index([organization_id], map: "ix_status_quo_items_organization_id")
}

model subscriptions {
  id                   Int       @id @default(autoincrement())
  organization_id      String    @db.Uuid
  plan_id              Int
  status               String    @db.VarChar(50)
  current_period_start DateTime? @default(now()) @db.Timestamptz(6)
  current_period_end   DateTime  @db.Timestamptz(6)
  plans                plans     @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_subscriptions_id")
  @@index([organization_id], map: "ix_subscriptions_organization_id")
}

model tasks {
  id                                     Int       @id @default(autoincrement())
  title                                  String?   @db.VarChar
  description                            String?
  status                                 String?   @db.VarChar
  priority                               String?   @db.VarChar
  due_date                               DateTime? @db.Timestamp(6)
  created_at                             DateTime? @db.Timestamp(6)
  updated_at                             DateTime? @db.Timestamp(6)
  organization_id                        String    @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  assigned_to_user_id                    Int?
  created_by_user_id                     Int       @default(1)
  linked_entity_type                     String?   @db.VarChar(50)
  linked_entity_id                       Int?
  is_deleted                             Boolean   @default(false)
  source_type                            String?   @db.VarChar(50)
  source_id                              Int?
  users_tasks_assigned_to_user_idTousers User?     @relation("tasks_assigned_to_user_idTousers", fields: [assigned_to_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_assigned_to_user_id")
  users_tasks_created_by_user_idTousers  User      @relation("tasks_created_by_user_idTousers", fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_created_by_user_id")

  @@unique([organization_id, source_type, source_id], map: "uq_task_org_source")
  @@index([id], map: "ix_tasks_id")
  @@index([organization_id], map: "ix_tasks_organization_id")
  @@index([source_id], map: "ix_tasks_source_id")
  @@index([source_type], map: "ix_tasks_source_type")
  @@index([title], map: "ix_tasks_title")
}

model track_releases {
  track_id   Int
  release_id Int
  releases   releases @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tracks     tracks   @relation(fields: [track_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([track_id, release_id])
}

model tracks {
  id                   Int                    @id @default(autoincrement())
  track_id             String?                @unique(map: "ix_tracks_track_id") @db.VarChar(50)
  title                String                 @db.VarChar(255)
  duration             DateTime?              @db.Time(6)
  genre                String?                @db.VarChar(100)
  release_date         DateTime?              @db.Date
  isrc_code            String?                @unique @db.VarChar(50)
  streaming_link       String?                @db.VarChar(500)
  artist_ids           Json?                  @db.Json
  file_location        String?                @db.VarChar(500)
  release_id           Int?
  work_id              Int?
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @db.Timestamptz(6)
  credits              Json?                  @db.Json
  contract_track_links contract_track_links[]
  royalties            royalties[]
  track_releases       track_releases[]
  releases             releases?              @relation(fields: [release_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  works                works?                 @relation(fields: [work_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([genre], map: "ix_tracks_genre")
  @@index([id], map: "ix_tracks_id")
  @@index([title], map: "ix_tracks_title")
}

model usage {
  id              Int    @id @default(autoincrement())
  organization_id String @db.Uuid
  metric          String @db.VarChar(50)
  value           Int
  tokens_used     BigInt
  period          String @db.VarChar(10)

  @@index([id], map: "ix_usage_id")
  @@index([organization_id, metric, period], map: "ix_usage_org_metric_period")
  @@index([organization_id], map: "ix_usage_organization_id")
}

model works {
  id              Int          @id @default(autoincrement())
  work_id         String?      @unique(map: "ix_works_work_id") @db.VarChar(50)
  title           String       @db.VarChar(255)
  iswc_code       String?      @db.VarChar(50)
  composers       Json?        @db.Json
  composers_text  String?
  arrangers       Json?        @db.Json
  arrangers_text  String?
  publisher_id    Int?
  pro_id          Int?
  created_at      DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?    @db.Timestamptz(6)
  organization_id String       @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  is_deleted      Boolean      @default(false)
  royalties       royalties[]
  tracks          tracks[]
  pros            pros?        @relation(fields: [pro_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  publishers      publishers?  @relation(fields: [publisher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  works_admin     works_admin?

  @@index([id], map: "ix_works_id")
  @@index([organization_id], map: "ix_works_organization_id")
  @@index([title], map: "ix_works_title")
}

model works_admin {
  id                     String                  @id @db.Uuid
  organization_id        String                  @db.Uuid
  work_id                Int                     @unique
  registration_status    String                  @default("Unknown") @db.VarChar(50)
  registered_with        String?                 @db.VarChar(255)
  registration_date      DateTime?               @db.Date
  registration_reference String?                 @db.VarChar(255)
  notes                  String?
  created_by             Int?
  created_at             DateTime?               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?               @db.Timestamptz(6)
  works                  works                   @relation(fields: [work_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  works_admin_documents  works_admin_documents[]

  @@unique([organization_id, work_id], map: "ix_works_admin_org_work")
}

model works_admin_documents {
  id              String      @id @db.Uuid
  organization_id String      @db.Uuid
  works_admin_id  String      @db.Uuid
  doc_type        String      @db.VarChar(100)
  file_path       String      @db.VarChar(500)
  file_name       String      @db.VarChar(255)
  mime_type       String?     @default("application/pdf") @db.VarChar(100)
  size_bytes      Int?
  checksum        String?     @db.VarChar(64)
  uploaded_by     Int?
  uploaded_at     DateTime?   @default(now()) @db.Timestamptz(6)
  works_admin     works_admin @relation(fields: [works_admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organization_id], map: "ix_works_admin_documents_organization_id")
}
