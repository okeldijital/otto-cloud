  @@index([contractId], map: "ix_contract_rel_events_contract")
  @@index([eventType], map: "ix_contract_rel_events_type")
  @@map("contract_relationship_events")
}

// ---------------------------------------------------------------------------
// Contract Lifecycle (Milestone 4.1)
// Deterministic operational state machine — no AI.
// See: docs/product/contract-center/adr-015-contract-lifecycle.md
// ---------------------------------------------------------------------------

model ContractLifecycle {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  contractId            Int       @unique
  verifiedContractId    String?   @db.Uuid
  /// draft | pending_verification | verified | active | pending_renewal | expired | terminated | superseded | archived
  status                String    @default("draft") @db.VarChar(32)
  previousStatus        String?   @db.VarChar(32)
  statusChangedAt       DateTime? @db.Timestamptz(6)
  statusChangedBy       Int?
  /// Renewal
  autoRenew             Boolean   @default(false)
  renewalIntervalMonths Int?
  noticePeriodDays      Int?
  /// pending | due | completed | waived | none
  renewalStatus         String    @default("none") @db.VarChar(32)
  /// Supersession
  supersedesContractId  Int?
  supersededByContractId Int?
  supersessionReason    String?
  supersessionDate      DateTime? @db.Date
  notes                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  keyDates   ContractKeyDate[]
  renewals   ContractRenewal[]
  amendments ContractAmendment[]

  @@index([organizationId], map: "ix_contract_lifecycles_org")
  @@index([status], map: "ix_contract_lifecycles_status")
  @@index([renewalStatus], map: "ix_contract_lifecycles_renewal")
  @@map("contract_lifecycles")
}

model ContractKeyDate {
  id             String   @id @default(uuid()) @db.Uuid
  lifecycleId    String   @db.Uuid
  organizationId String   @db.Uuid
  contractId     Int
  /// effective | execution | expiration | renewal | notice_deadline | termination | review
  dateType       String   @db.VarChar(32)
  /// ISO date stored as Date; time optional via timezone field
  dateValue      DateTime @db.Date
  timezone       String   @default("UTC") @db.VarChar(64)
  /// verified | draft | system | manual
  verificationState String @default("manual") @db.VarChar(32)
  /// verified_contract | lifecycle | manual | legacy
  source         String   @default("manual") @db.VarChar(32)
  sourceRef      String?
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  lifecycle ContractLifecycle @relation(fields: [lifecycleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([lifecycleId, dateType], map: "uq_contract_key_date_type")
  @@index([contractId], map: "ix_contract_key_dates_contract")
  @@index([dateType, dateValue], map: "ix_contract_key_dates_type_value")
  @@map("contract_key_dates")
}

model ContractRenewal {
  id             String    @id @default(uuid()) @db.Uuid
  lifecycleId    String    @db.Uuid
  organizationId String    @db.Uuid
  contractId     Int
  /// scheduled | completed | skipped | cancelled
  status         String    @default("scheduled") @db.VarChar(32)
  scheduledDate  DateTime? @db.Date
  completedDate  DateTime? @db.Date
  intervalMonths Int?
  noticeDays     Int?
  notes          String?
  createdBy      Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  lifecycle ContractLifecycle @relation(fields: [lifecycleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([lifecycleId], map: "ix_contract_renewals_lifecycle")
  @@index([contractId], map: "ix_contract_renewals_contract")
  @@map("contract_renewals")
}

model ContractAmendment {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @db.Uuid
  contractId           Int
  lifecycleId          String    @db.Uuid
  amendmentNumber      String    @db.VarChar(64)
