  verifiedContractId String?   @db.Uuid
  verifiedVersion    Int?
  verificationStatus String?   @db.VarChar(32)
  lifecycleStatus    String?   @db.VarChar(32)
  contractStatus     String?   @db.VarChar(32)
  effectiveDate      DateTime? @db.Date
  expirationDate     DateTime? @db.Date
  renewalDate        DateTime? @db.Date
  noticeDeadline     DateTime? @db.Date
  lastVerifiedAt     DateTime? @db.Timestamptz(6)
  partiesJson        Json      @default("[]")
  territoriesJson    Json      @default("[]")
