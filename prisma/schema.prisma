generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                                     Int                             @id @default(autoincrement())
  email                                  String                          @unique(map: "ix_users_email") @db.VarChar(255)
  hashed_password                        String                          @db.VarChar(255)
  name                                   String?                         @map("full_name") @db.VarChar(255)
  is_active                              Boolean?
  is_superuser                           Boolean?
  role                                   String?                         @db.VarChar(50)
  createdAt                              DateTime?                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                              DateTime?                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  last_login                             DateTime?                       @db.Timestamptz(6)
  avatar_url                             String?                         @db.VarChar(500)
  organization_id                        String                          @default(dbgenerated("'00000000-0000-0000-0000-000000000001'::uuid")) @db.Uuid
  activities                             activities[]
  admin_backup_artifacts                 admin_backup_artifacts[]
  admin_backup_restore_events            admin_backup_restore_events[]
  admin_restore_audit                    admin_restore_audit[]
  ai_contract_attach_runs                ai_contract_attach_runs[]
  ai_contract_documents                  ai_contract_documents[]
  ai_contract_drafts                     ai_contract_drafts[]
  ai_contract_resolution_runs            ai_contract_resolution_runs[]
  ai_core_write_apply_events             ai_core_write_apply_events[]
  ai_core_write_proposal_runs            ai_core_write_proposal_runs[]
  ai_release_integration_runs            ai_release_integration_runs[]
  ai_royalty_simulation_runs             ai_royalty_simulation_runs[]
  ai_sessions                            ai_sessions[]
  audit_logs                             audit_logs[]
  contract_intake_release_links          contract_intake_release_links[]
  documents                              documents[]
  events                                 events[]
  jobs                                   jobs[]
  notes                                  notes[]
  office_documents                       office_documents[]
  office_notes                           office_notes[]
  playlists                              playlists[]
  report_definitions                     report_definitions[]
  report_runs                            report_runs[]
  status_quo_items                       status_quo_items[]
  tasks_tasks_assigned_to_user_idTousers tasks[]                         @relation("tasks_assigned_to_user_idTousers")
  tasks_tasks_created_by_user_idTousers  tasks[]                         @relation("tasks_created_by_user_idTousers")

  @@index([id], map: "ix_users_id")
  @@index([organization_id], map: "ix_users_organization_id")
  @@map("users")
}

model activities {
  id          Int      @id @default(autoincrement())
  user_id     Int
  action      String   @db.VarChar
  entity_type String   @db.VarChar
  entity_id   Int
  entity_name String?  @db.VarChar
  timestamp   DateTime @db.Timestamp(6)
  users       User     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_activities_id")
}

model admin_backup_artifacts {
  id                      Int       @id @default(autoincrement())
  organization_id         Int
  created_by              Int
  backup_kind             String    @db.VarChar(32)
  filename                String    @db.VarChar(255)
  file_path               String    @db.VarChar(1000)
  size_bytes              Int
  sha256                  String    @db.VarChar(64)
  is_pre_restore_snapshot Boolean   @default(false)
  source_backup_id        Int?
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  users                   User      @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, sha256], map: "uq_admin_backup_artifact_org_sha256")
  @@index([backup_kind], map: "ix_admin_backup_artifacts_backup_kind")
  @@index([created_at], map: "ix_admin_backup_artifacts_created_at")
  @@index([created_by], map: "ix_admin_backup_artifacts_created_by")
  @@index([id], map: "ix_admin_backup_artifacts_id")
  @@index([is_pre_restore_snapshot], map: "ix_admin_backup_artifacts_is_pre_restore_snapshot")
  @@index([organization_id], map: "ix_admin_backup_artifacts_organization_id")
  @@index([sha256], map: "ix_admin_backup_artifacts_sha256")
  @@index([source_backup_id], map: "ix_admin_backup_artifacts_source_backup_id")
}

model admin_backup_restore_events {
  id                 Int       @id @default(autoincrement())
  backup_id          Int
  snapshot_backup_id Int?
  initiator_user_id  Int
  initiator_org_id   Int
  status             String    @db.VarChar(16)
  error              String?
  duration_ms        Int?
  created_at         DateTime? @default(now()) @db.Timestamptz(6)
  users              User      @relation(fields: [initiator_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([backup_id], map: "ix_admin_backup_restore_events_backup_id")
  @@index([created_at], map: "ix_admin_backup_restore_events_created_at")
  @@index([id], map: "ix_admin_backup_restore_events_id")
  @@index([initiator_org_id], map: "ix_admin_backup_restore_events_initiator_org_id")
  @@index([initiator_user_id], map: "ix_admin_backup_restore_events_initiator_user_id")
  @@index([snapshot_backup_id], map: "ix_admin_backup_restore_events_snapshot_backup_id")
  @@index([status], map: "ix_admin_backup_restore_events_status")
}

model admin_restore_audit {
  id                      Int       @id @default(autoincrement())
  organization_id         Int
  user_id                 Int
  backup_id               Int
  pre_restore_snapshot_id Int?
  request_hash            String    @db.VarChar(64)
  result                  String    @db.VarChar(16)
  error_hash              String?   @db.VarChar(64)
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  users                   User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([backup_id], map: "ix_admin_restore_audit_backup_id")
  @@index([created_at], map: "ix_admin_restore_audit_created_at")
  @@index([id], map: "ix_admin_restore_audit_id")
  @@index([organization_id], map: "ix_admin_restore_audit_organization_id")
  @@index([pre_restore_snapshot_id], map: "ix_admin_restore_audit_pre_restore_snapshot_id")
  @@index([request_hash], map: "ix_admin_restore_audit_request_hash")
  @@index([result], map: "ix_admin_restore_audit_result")
  @@index([user_id], map: "ix_admin_restore_audit_user_id")
}

model ai_audit_log {
  id              Int       @id @default(autoincrement())
  organization_id String    @db.Uuid
  user_id         Int
  action          String    @db.VarChar(50)
  tool            String?   @db.VarChar(50)
  request_hash    String    @db.VarChar(64)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  parser_version  String?   @db.VarChar(20)

  @@index([created_at], map: "ix_ai_audit_log_created_at")
  @@index([id], map: "ix_ai_audit_log_id")
  @@index([organization_id], map: "ix_ai_audit_log_organization_id")
  @@index([user_id], map: "ix_ai_audit_log_user_id")
}

model ai_contract_attach_links {
  id                      Int                     @id @default(autoincrement())
  organization_id         String                  @db.Uuid
  run_id                  Int
  action_type             String                  @db.VarChar(64)
  target_name             String?                 @db.VarChar(255)
  entity_id               Int?
  confidence              Float
  details_json            String?
  created_at              DateTime?               @default(now()) @db.Timestamptz(6)
  ai_contract_attach_runs ai_contract_attach_runs @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([action_type], map: "ix_ai_contract_attach_links_action_type")
  @@index([created_at], map: "ix_ai_contract_attach_links_created_at")
  @@index([id], map: "ix_ai_contract_attach_links_id")
  @@index([organization_id], map: "ix_ai_contract_attach_links_organization_id")
  @@index([run_id], map: "ix_ai_contract_attach_links_run_id")
}

model ai_contract_attach_runs {
  id                       Int                        @id @default(autoincrement())
  organization_id          String                     @db.Uuid
  user_id                  Int
  contract_id              Int
  release_id               Int
  request_hash             String                     @db.VarChar(64)
  warnings_json            String?
  created_at               DateTime?                  @default(now()) @db.Timestamptz(6)
  ai_contract_attach_links ai_contract_attach_links[]
  users                    User                       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, request_hash], map: "uq_ai_contract_attach_runs_org_reqhash")
  @@index([contract_id], map: "ix_ai_contract_attach_runs_contract_id")
  @@index([created_at], map: "ix_ai_contract_attach_runs_created_at")
  @@index([id], map: "ix_ai_contract_attach_runs_id")
  @@index([organization_id], map: "ix_ai_contract_attach_runs_organization_id")
  @@index([release_id], map: "ix_ai_contract_attach_runs_release_id")
  @@index([request_hash], map: "ix_ai_contract_attach_runs_request_hash")
  @@index([user_id], map: "ix_ai_contract_attach_runs_user_id")
}

model ai_contract_documents {
  id                     Int                      @id @default(autoincrement())
  organization_id        Int
  release_id             Int
  file_path              String                   @db.VarChar(1000)
  file_hash              String                   @db.VarChar(64)
  uploaded_by            Int
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  users                  User                     @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ai_contract_work_links ai_contract_work_links[]

  @@unique([organization_id, release_id, file_hash], map: "uq_ai_contract_document_org_release_hash")
  @@index([created_at], map: "ix_ai_contract_documents_created_at")
  @@index([file_hash], map: "ix_ai_contract_documents_file_hash")
  @@index([id], map: "ix_ai_contract_documents_id")
  @@index([organization_id], map: "ix_ai_contract_documents_organization_id")
  @@index([release_id], map: "ix_ai_contract_documents_release_id")
  @@index([uploaded_by], map: "ix_ai_contract_documents_uploaded_by")
}

model ai_contract_drafts {
  id                      String    @id @db.VarChar(64)
  organization_id         String    @db.Uuid
  created_by              Int
  source                  String?   @db.VarChar(32)
  file_path               String    @db.VarChar(1000)
  file_name               String    @db.VarChar(255)
  file_hash               String    @db.VarChar(64)
  size_bytes              Int
  extraction_json         String
  suggested_defaults_json String
  created_at              DateTime? @default(now()) @db.Timestamptz(6)
  users                   User      @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, file_hash], map: "uq_ai_contract_drafts_org_hash")
  @@index([created_at], map: "ix_ai_contract_drafts_created_at")
  @@index([created_by], map: "ix_ai_contract_drafts_created_by")
  @@index([file_hash], map: "ix_ai_contract_drafts_file_hash")
  @@index([id], map: "ix_ai_contract_drafts_id")
  @@index([organization_id], map: "ix_ai_contract_drafts_organization_id")
}

model ai_contract_resolution_links {
  id                          Int                         @id @default(autoincrement())
  run_id                      Int
  entity_type                 String                      @db.VarChar(50)
  entity_id                   Int?
  action                      String                      @db.VarChar(20)
  confidence                  Int?
  rationale                   String?
  created_at                  DateTime?                   @default(now()) @db.Timestamptz(6)
  ai_contract_resolution_runs ai_contract_resolution_runs @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_ai_contract_resolution_links_id")
  @@index([run_id], map: "ix_ai_contract_resolution_links_run_id")
}

model ai_contract_resolution_runs {
  id                            Int                             @id @default(autoincrement())
  organization_id               String                          @db.Uuid
  user_id                       Int
  contract_hash                 String                          @db.VarChar(64)
  extractor_version             String?                         @db.VarChar(50)
  linker_version                String?                         @db.VarChar(50)
  created_at                    DateTime?                       @default(now()) @db.Timestamptz(6)
  ai_contract_resolution_links  ai_contract_resolution_links[]
  users                         User                            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract_intake_release_links contract_intake_release_links[]

  @@index([contract_hash], map: "ix_ai_contract_resolution_runs_contract_hash")
  @@index([created_at], map: "ix_ai_contract_resolution_runs_created_at")
  @@index([id], map: "ix_ai_contract_resolution_runs_id")
  @@index([organization_id], map: "ix_ai_contract_resolution_runs_organization_id")
}

model ai_contract_work_links {
  id                    Int                   @id @default(autoincrement())
  organization_id       Int
  contract_document_id  Int
  work_id               Int
  confidence            Float
  match_strategy        String                @db.VarChar(20)
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  ai_contract_documents ai_contract_documents @relation(fields: [contract_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, contract_document_id, work_id], map: "uq_ai_contract_work_link_org_doc_work")
  @@index([contract_document_id], map: "ix_ai_contract_work_links_contract_document_id")
  @@index([created_at], map: "ix_ai_contract_work_links_created_at")
  @@index([id], map: "ix_ai_contract_work_links_id")
  @@index([organization_id], map: "ix_ai_contract_work_links_organization_id")
  @@index([work_id], map: "ix_ai_contract_work_links_work_id")
}

model ai_core_write_apply_events {
  id                          Int                         @id @default(autoincrement())
  organization_id             Int
  user_id                     Int
  run_id                      Int
  request_hash                String                      @db.VarChar(64)
  status                      String                      @db.VarChar(16)
  applied_count               Int                         @default(0)
  created_count               Int                         @default(0)
  conflict_count              Int                         @default(0)
  details_json                String?
  created_at                  DateTime?                   @default(now()) @db.Timestamptz(6)
  ai_core_write_proposal_runs ai_core_write_proposal_runs @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                       User                        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "ix_ai_core_write_apply_events_created_at")
  @@index([id], map: "ix_ai_core_write_apply_events_id")
  @@index([organization_id], map: "ix_ai_core_write_apply_events_organization_id")
  @@index([request_hash], map: "ix_ai_core_write_apply_events_request_hash")
  @@index([run_id], map: "ix_ai_core_write_apply_events_run_id")
  @@index([status], map: "ix_ai_core_write_apply_events_status")
  @@index([user_id], map: "ix_ai_core_write_apply_events_user_id")
}

model ai_core_write_proposal_items {
  id                          Int                         @id @default(autoincrement())
  organization_id             Int
  run_id                      Int
  entity_type                 String                      @db.VarChar(64)
  entity_id                   Int?
  operation                   String                      @db.VarChar(16)
  patch_json                  String
  conflicts_json              String?
  safe_defaults_json          String?
  requires_user_review        Boolean                     @default(true)
  created_at                  DateTime?                   @default(now()) @db.Timestamptz(6)
  ai_core_write_proposal_runs ai_core_write_proposal_runs @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at], map: "ix_ai_core_write_proposal_items_created_at")
  @@index([entity_id], map: "ix_ai_core_write_proposal_items_entity_id")
  @@index([entity_type], map: "ix_ai_core_write_proposal_items_entity_type")
  @@index([id], map: "ix_ai_core_write_proposal_items_id")
  @@index([operation], map: "ix_ai_core_write_proposal_items_operation")
  @@index([organization_id], map: "ix_ai_core_write_proposal_items_organization_id")
  @@index([requires_user_review], map: "ix_ai_core_write_proposal_items_requires_user_review")
  @@index([run_id], map: "ix_ai_core_write_proposal_items_run_id")
}

model ai_core_write_proposal_runs {
  id                           Int                            @id @default(autoincrement())
  organization_id              Int
  user_id                      Int
  contract_id                  Int
  release_id                   Int?
  contract_document_id         Int?
  request_hash                 String                         @db.VarChar(64)
  parser_version               String?                        @db.VarChar(64)
  linker_version               String?                        @db.VarChar(64)
  planner_version              String?                        @db.VarChar(64)
  created_at                   DateTime?                      @default(now()) @db.Timestamptz(6)
  ai_core_write_apply_events   ai_core_write_apply_events[]
  ai_core_write_proposal_items ai_core_write_proposal_items[]
  users                        User                           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([contract_document_id], map: "ix_ai_core_write_proposal_runs_contract_document_id")
  @@index([contract_id], map: "ix_ai_core_write_proposal_runs_contract_id")
  @@index([created_at], map: "ix_ai_core_write_proposal_runs_created_at")
  @@index([id], map: "ix_ai_core_write_proposal_runs_id")
  @@index([organization_id], map: "ix_ai_core_write_proposal_runs_organization_id")
  @@index([release_id], map: "ix_ai_core_write_proposal_runs_release_id")
  @@index([request_hash], map: "ix_ai_core_write_proposal_runs_request_hash")
  @@index([user_id], map: "ix_ai_core_write_proposal_runs_user_id")
}

model ai_messages {
  id          Int         @id @default(autoincrement())
  session_id  Int
  role        String      @db.VarChar(20)
  content     String
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  ai_sessions ai_sessions @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_ai_messages_id")
  @@index([session_id], map: "ix_ai_messages_session_id")
}

model ai_release_integration_links {
  id                          Int                         @id @default(autoincrement())
  organization_id             Int
  run_id                      Int
  entity_type                 String                      @db.VarChar(32)
  entity_id                   Int?
  display_name                String                      @db.VarChar(255)
  action                      String                      @db.VarChar(32)
  confidence                  Float?
  match_strategy              String                      @db.VarChar(20)
  rationale                   String?
  created_at                  DateTime?                   @default(now()) @db.Timestamptz(6)
  ai_release_integration_runs ai_release_integration_runs @relation(fields: [run_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, run_id, entity_type, entity_id, action], map: "uq_ai_release_integration_link_org_run_entity_action")
  @@index([action], map: "ix_ai_release_integration_links_action")
  @@index([created_at], map: "ix_ai_release_integration_links_created_at")
  @@index([entity_id], map: "ix_ai_release_integration_links_entity_id")
  @@index([entity_type], map: "ix_ai_release_integration_links_entity_type")
  @@index([id], map: "ix_ai_release_integration_links_id")
  @@index([organization_id], map: "ix_ai_release_integration_links_organization_id")
  @@index([run_id], map: "ix_ai_release_integration_links_run_id")
}

model ai_release_integration_runs {
  id                           Int                            @id @default(autoincrement())
  organization_id              Int
  user_id                      Int
  release_id                   Int
  contract_id                  Int?
  request_hash                 String                         @db.VarChar(64)
  planner_version              String                         @db.VarChar(50)
  created_at                   DateTime?                      @default(now()) @db.Timestamptz(6)
  ai_release_integration_links ai_release_integration_links[]
  users                        User                           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, release_id, request_hash], map: "uq_ai_release_integration_run_org_release_hash")
  @@index([contract_id], map: "ix_ai_release_integration_runs_contract_id")
  @@index([created_at], map: "ix_ai_release_integration_runs_created_at")
  @@index([id], map: "ix_ai_release_integration_runs_id")
  @@index([organization_id], map: "ix_ai_release_integration_runs_organization_id")
  @@index([release_id], map: "ix_ai_release_integration_runs_release_id")
  @@index([user_id], map: "ix_ai_release_integration_runs_user_id")
}

model ai_royalty_simulation_runs {
  id                         Int       @id @default(autoincrement())
  organization_id            Int
  user_id                    Int
  release_id                 Int
  contract_document_id       Int?
  request_hash               String    @db.VarChar(64)
  royalty_version            String    @db.VarChar(50)
  splits_total               Float
  integrity_total_equals_100 Boolean
  integrity_over_allocated   Boolean
  integrity_under_allocated  Boolean
  created_at                 DateTime? @default(now()) @db.Timestamptz(6)
  users                      User      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organization_id, release_id, request_hash], map: "uq_ai_royalty_run_org_release_hash")
  @@index([contract_document_id], map: "ix_ai_royalty_simulation_runs_contract_document_id")
  @@index([created_at], map: "ix_ai_royalty_simulation_runs_created_at")
  @@index([id], map: "ix_ai_royalty_simulation_runs_id")
  @@index([organization_id], map: "ix_ai_royalty_simulation_runs_organization_id")
  @@index([release_id], map: "ix_ai_royalty_simulation_runs_release_id")
  @@index([user_id], map: "ix_ai_royalty_simulation_runs_user_id")
}

model ai_sessions {
  id              Int           @id @default(autoincrement())
  organization_id String        @db.Uuid
  user_id         Int
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  ai_messages     ai_messages[]
  users           User          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_ai_sessions_id")
  @@index([organization_id], map: "ix_ai_sessions_organization_id")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model artist_memberships {
  id                                            Int       @id @default(autoincrement())
  group_id                                      Int
  member_id                                     Int
  organization_id                               Int?
  role                                          String?   @db.VarChar(100)
  joined_at                                     DateTime? @default(now()) @db.Timestamptz(6)
  artists_artist_memberships_group_idToartists  artists   @relation("artist_memberships_group_idToartists", fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  artists_artist_memberships_member_idToartists artists   @relation("artist_memberships_member_idToartists", fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, member_id], map: "ix_membership_group_member")
  @@index([group_id], map: "ix_artist_memberships_group_id")
  @@index([member_id], map: "ix_artist_memberships_member_id")
  @@index([organization_id, group_id], map: "ix_membership_org_group")
}

model artists {
  id                                                       Int                  @id @default(autoincrement())
  artist_id                                                String?              @unique(map: "ix_artists_artist_id") @db.VarChar(50)
