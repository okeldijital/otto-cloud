  organizationId     String    @db.Uuid
  releaseId          Int
  contractId         Int
  relationshipId     String?   @db.Uuid
  relationshipType   String?   @db.VarChar(64)
  /// Snapshot fields from verified / lifecycle (not source of ownership)
