}

// ---------------------------------------------------------------------------
// Rights Management Domain (Milestone 6.0)
// Operational rights derived from Verified Contracts — not legal evidence.
// See: docs/product/rights/adr-020-rights-domain.md
// ---------------------------------------------------------------------------

/// Canonical registry entry for an operational right.
model Right {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  /// Human-readable title
  title              String    @db.VarChar(255)
  /// Data-driven category key
  category           String    @db.VarChar(64)
  description        String?
  /// candidate | pending_review | approved | active | suspended | expired | superseded | terminated | archived
  status             String    @default("candidate") @db.VarChar(32)
  previousStatus     String?   @db.VarChar(32)
  statusChangedAt    DateTime? @db.Timestamptz(6)
  statusChangedBy    Int?
  version            Int       @default(1)
  isCurrent          Boolean   @default(true)
  exclusive          Boolean   @default(false)
  perpetual          Boolean   @default(false)
  effectiveDate      DateTime? @db.Date
  expirationDate     DateTime? @db.Date
  renewalDate        DateTime? @db.Date
  terminationDate    DateTime? @db.Date
  /// Owner type: organization | label | publisher | artist | individual | estate | custom
  ownerType          String?   @db.VarChar(32)
  ownerEntityId      String?   @db.VarChar(64)
  ownerName          String?
  /// Provenance (required for approved/active)
  verifiedContractId String?   @db.Uuid
  contractId         Int?
  verificationSessionId String? @db.Uuid
  verifiedVersion    Int?
  documentId         String?   @db.Uuid
  clauseReference    String?
  promotionRunId     String?   @db.Uuid
  candidateId        String?   @db.Uuid
  reviewedBy         Int?
  reviewedAt         DateTime? @db.Timestamptz(6)
  approvedBy         Int?
  approvedAt         DateTime? @db.Timestamptz(6)
  provenance         Json      @default("{}")
  createdBy          Int?
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  grants           RightGrant[]
  restrictions     RightRestriction[]
  parties          RightParty[]
  territories      RightTerritory[]
  works            RightWork[]
  releases         RightRelease[]
  contractRefs     RightContractReference[]
  history          RightHistory[]
  timeline         RightTimelineEntry[]

  @@index([organizationId, status], map: "ix_rights_org_status")
  @@index([category], map: "ix_rights_category")
  @@index([contractId], map: "ix_rights_contract")
  @@index([verifiedContractId], map: "ix_rights_verified_contract")
  @@index([ownerType, ownerEntityId], map: "ix_rights_owner")
  @@index([expirationDate], map: "ix_rights_expiration")
  @@map("rights")
}

model RightGrant {
  id             String   @id @default(uuid()) @db.Uuid
  rightId        String   @db.Uuid
  organizationId String   @db.Uuid
  /// license | assignment | administration | exclusive_license | etc.
  grantType      String   @db.VarChar(64)
  grantScope     String?
  exclusive      Boolean  @default(false)
  transferable   Boolean  @default(false)
  assignable     Boolean  @default(false)
  sublicensable  Boolean  @default(false)
  revocable      Boolean  @default(true)
  perpetual      Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  right Right @relation(fields: [rightId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([rightId], map: "ix_right_grants_right")
  @@map("right_grants")
}

model RightRestriction {
  id             String    @id @default(uuid()) @db.Uuid
  rightId        String    @db.Uuid
  organizationId String    @db.Uuid
  /// territory | platform | media | language | time | usage | distribution | exclusivity | carve_out | suspension | custom
  restrictionType String   @db.VarChar(64)
  value          String
