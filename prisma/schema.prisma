  @@index([releaseId], map: "ix_release_contract_summary_release")
  @@index([contractId], map: "ix_release_contract_summary_contract")
  @@index([lifecycleStatus], map: "ix_release_contract_summary_lifecycle")
  @@index([healthStatus], map: "ix_release_contract_summary_health")
  @@index([expirationDate], map: "ix_release_contract_summary_expiration")
  @@map("release_contract_summaries")
}

/// Release-scoped unified timeline of contract-related operational events.
model ReleaseContractTimelineEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  releaseId      Int
  contractId     Int?
  /// release | lifecycle | relationship | verification | document | amendment | system
  entryType      String   @db.VarChar(64)
  title          String   @db.VarChar(255)
