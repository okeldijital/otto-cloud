# =============================================================================
# OTTO Cloud — Environment Configuration
# =============================================================================
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Legend:
#   [required]           Must be set for the app / bootstrap to function
#   [optional]           Has a safe default or is feature-specific
#   [development only]   Never use these values/flags in production
#   [production only]    Required or strongly recommended in production
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="iam-lab"
# PRODUCTION_DATABASE_HOSTS="ep-prod-xxxx.region.aws.neon.tech"

# -----------------------------------------------------------------------------
# Application environment
# -----------------------------------------------------------------------------

NODE_ENV="development"
APP_ENV="development"
OTTO_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Better Auth — runtime authentication provider
# -----------------------------------------------------------------------------

# [required in production] High-entropy secret, minimum 32 characters.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-long-random-secret"
# [optional] Public URL used by Better Auth for redirects and cookies.
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Transactional email
# -----------------------------------------------------------------------------

RESEND_API_KEY=""
EMAIL_FROM="OTTO <noreply@yourdomain.com>"
# IAM_EXPOSE_AUTH_LINKS="false"

# -----------------------------------------------------------------------------
# Legacy/native IAM cryptography
# -----------------------------------------------------------------------------

NEXTAUTH_SECRET="replace-with-long-random-secret"
IAM_ENCRYPTION_KEY=""
IAM_ACCESS_TOKEN_SECRET=""

# -----------------------------------------------------------------------------
# IAM bootstrap
# -----------------------------------------------------------------------------

INITIAL_ADMIN_NAME="Administrator"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMe-Strong-Password-1!"
INITIAL_ORG_NAME="Otto"
INITIAL_ORG_SLUG="otto"
# ALLOW_PRODUCTION_BOOTSTRAP="false"
# ALLOW_DESTRUCTIVE_DB_OPS="false"
# REQUIRE_IAM_LAB="1"

# -----------------------------------------------------------------------------
# Cookie / session security
# -----------------------------------------------------------------------------

# IAM_COOKIE_SECURE="true"
# SECURITY_COOKIE_SECURE="true"
# SECURITY_SESSION_MAX_AGE_HOURS="12"
# SECURITY_SESSION_IDLE_TIMEOUT_HOURS="4"
# SECURITY_SESSION_REMEMBER_ME_DAYS="30"
# SECURITY_REFRESH_TOKEN_DAYS="30"
# SECURITY_ACCESS_TOKEN_MINUTES="15"
# SECURITY_SESSION_MAX_CONCURRENT="10"

# -----------------------------------------------------------------------------
# Password / lockout / MFA policy
# -----------------------------------------------------------------------------

# SECURITY_PASSWORD_MIN_LENGTH="12"
# SECURITY_PASSWORD_REQUIRE_SYMBOLS="true"
# SECURITY_LOCKOUT_MAX_ATTEMPTS="5"
# SECURITY_LOCKOUT_DURATION_MINUTES="15"
# SECURITY_LOGIN_RATE_LIMIT_PER_MINUTE="20"
# SECURITY_MFA_REQUIRED_FOR_ADMINS="false"
# SECURITY_MFA_ISSUER="OTTO"
# SECURITY_MFA_TRUSTED_DEVICE_DAYS="30"
# SECURITY_PASSWORD_RESET_TTL_MINUTES="60"
# SECURITY_EMAIL_VERIFICATION_TTL_HOURS="48"
# SECURITY_INVITATION_TTL_DAYS="7"

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------

# FEATURE_IAM_NATIVE_AUTH="true"
# FEATURE_IAM_MFA="true"

# -----------------------------------------------------------------------------
# Object storage (Cloudflare R2)
# -----------------------------------------------------------------------------

# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_ENDPOINT=""

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# LOG_LEVEL="warn"

# -----------------------------------------------------------------------------
# Vercel
# -----------------------------------------------------------------------------

# VERCEL_ENV=production|preview|development
# VERCEL_URL=...
