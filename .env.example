# =============================================================================
# OTTO Cloud — Environment Configuration
# =============================================================================
# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Legend:
#   [required]           Must be set for the app / bootstrap to function
#   [optional]           Has a safe default or is feature-specific
#   [development only]   Never use these values/flags in production
#   [production only]    Required or strongly recommended in production
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------

# [required] Pooled connection string (Neon pooler recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# [required] Direct (non-pooler) connection for Prisma migrations
#            Must be set even if equal to DATABASE_URL. Prefer the non-pooler
#            Neon endpoint for `prisma migrate deploy`.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# [optional] Explicit Neon branch name (used by bootstrap safety classification)
#            Set to "iam-lab" when hardening / validating against the lab branch.
NEON_BRANCH="iam-lab"

# [optional] Comma-separated production host markers for bootstrap safety
# PRODUCTION_DATABASE_HOSTS="ep-prod-xxxx.region.aws.neon.tech"

# -----------------------------------------------------------------------------
# Application environment
# -----------------------------------------------------------------------------

# [optional] development | preview | production
#            Used by bootstrap safety + Next.js. Prefer OTTO_ENV for scripts.
NODE_ENV="development"

# [optional] App-level env label: development | lab | preview | production
APP_ENV="development"
OTTO_ENV="development"

# [required in production] Public site URL (auth emails, redirects)
NEXTAUTH_URL="http://localhost:3000"
# [optional] Alternate public URL
NEXT_PUBLIC_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Secrets & cryptography
# -----------------------------------------------------------------------------

# [required] Session / legacy bridge secret (min 32 random bytes recommended)
#            Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-long-random-secret"

# [required in production] AES-256-GCM key for MFA secrets at rest
#            32-byte hex (64 chars) or base64. Falls back to NEXTAUTH_SECRET
#            hash in development only — do not rely on that in production.
#            Generate hex: openssl rand -hex 32
IAM_ENCRYPTION_KEY=""

# [optional] HMAC secret for short-lived access tokens
#            Falls back to IAM_ENCRYPTION_KEY then NEXTAUTH_SECRET
IAM_ACCESS_TOKEN_SECRET=""

# -----------------------------------------------------------------------------
# IAM bootstrap (scripts/bootstrap-iam.ts)
# -----------------------------------------------------------------------------

# [required for bootstrap] Initial administrator
INITIAL_ADMIN_NAME="Administrator"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMe-Strong-Password-1!"

# [optional] Default organization
INITIAL_ORG_NAME="Otto"
INITIAL_ORG_SLUG="otto"

# [development only] Allow bootstrap against production-classified DB
# ALLOW_PRODUCTION_BOOTSTRAP="false"

# [development only] Allow destructive ops (password force-reset flags, etc.)
# ALLOW_DESTRUCTIVE_DB_OPS="false"

# [development only] Require iam-lab classification
# REQUIRE_IAM_LAB="1"

# -----------------------------------------------------------------------------
# Cookie / session security
# -----------------------------------------------------------------------------

# [optional] Force Secure cookies outside NODE_ENV=production
# IAM_COOKIE_SECURE="true"
# SECURITY_COOKIE_SECURE="true"

# [optional] Session policy overrides
# SECURITY_SESSION_MAX_AGE_HOURS="12"
# SECURITY_SESSION_IDLE_TIMEOUT_HOURS="4"
# SECURITY_SESSION_REMEMBER_ME_DAYS="30"
# SECURITY_REFRESH_TOKEN_DAYS="30"
# SECURITY_ACCESS_TOKEN_MINUTES="15"
# SECURITY_SESSION_MAX_CONCURRENT="10"

# -----------------------------------------------------------------------------
# Password / lockout / MFA policy (optional overrides)
# -----------------------------------------------------------------------------

# SECURITY_PASSWORD_MIN_LENGTH="12"
# SECURITY_PASSWORD_REQUIRE_SYMBOLS="true"
# SECURITY_LOCKOUT_MAX_ATTEMPTS="5"
# SECURITY_LOCKOUT_DURATION_MINUTES="15"
# SECURITY_LOGIN_RATE_LIMIT_PER_MINUTE="20"
# SECURITY_MFA_REQUIRED_FOR_ADMINS="false"
# SECURITY_MFA_ISSUER="OTTO"
# SECURITY_MFA_TRUSTED_DEVICE_DAYS="30"
# SECURITY_PASSWORD_RESET_TTL_MINUTES="60"
# SECURITY_EMAIL_VERIFICATION_TTL_HOURS="48"
# SECURITY_INVITATION_TTL_DAYS="7"

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------

# [optional] IAM native auth (default true)
# FEATURE_IAM_NATIVE_AUTH="true"
# FEATURE_IAM_MFA="true"

# -----------------------------------------------------------------------------
# Object storage (Cloudflare R2) — document/asset features
# -----------------------------------------------------------------------------

# [optional for core IAM; required for document storage]
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_ENDPOINT=""

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# [optional] debug | info | warn | error
# LOG_LEVEL="warn"

# -----------------------------------------------------------------------------
# Vercel (injected automatically on Vercel — do not set manually in prod)
# -----------------------------------------------------------------------------
# VERCEL_ENV=production|preview|development
# VERCEL_URL=...
