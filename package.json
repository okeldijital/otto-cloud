{
    "name": "otto",
    "version": "1.0.1",
    "description": "OTTO: Multi-Platform Database & Collaboration Tool",
    "main": "main.js",
    "private": true,
    "scripts": {
        "dev": "cd frontend && npm run dev",
        "backend:dev": "cd backend && python3 main.py",
        "build": "bash build.sh",
        "build:frontend": "bash build_frontend.sh",
        "build:backend": "cd backend && bash build_backend.sh",
        "release": "git tag v1.0.1 && git push origin v1.0.1"
    },
    "devDependencies": {
        "electron": "^latest",
        "electron-builder": "^latest"
    },
    "build": {
        "appId": "com.otto.desktop",
        "productName": "OTTO",
        "directories": {
            "buildResources": "assets",
            "output": "dist-electron"
        },
        "files": [
            "package.json",
            "main.js",
            "preload.js",
            "dist/**/*",
            "dist-desktop/**/*",
            "node_modules/**/*"
        ],
        "mac": {
            "target": ["dmg", "zip"],
            "identity": null,
            "signingByDefault": false
        },
        "win": {
            "target": ["nsis", "portable"]
        },
        "linux": {
            "target": ["AppImage", "deb"]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    }
}