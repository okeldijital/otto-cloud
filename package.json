{
    "name": "otto",
    "version": "1.0.1",
    "description": "OTTO: Multi-Platform Database & Collaboration Tool",
    "private": true,
    "scripts": {
        "dev": "cd frontend && npm run dev",
        "backend:dev": "cd backend && python3 main.py",
        "build": "bash build.sh",
        "build:frontend": "bash build_frontend.sh",
        "build:backend": "cd backend && bash build_backend.sh",
        "release": "git tag v1.0.1 && git push origin v1.0.1"
    },
    "devDependencies": {
        "electron": "^latest",
        "electron-builder": "^latest"
    }
}