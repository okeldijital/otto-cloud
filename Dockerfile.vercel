FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-eng tesseract-ocr-zul \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ocr-worker/package.json ./package.json
RUN npm install --omit=dev

COPY ocr-worker/server.mjs ./server.mjs

ENV PORT=80
EXPOSE 80

CMD ["node", "server.mjs"]
